generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(uuid())
  clerkUserId            String              @unique
  email                  String              @unique
  name                   String?
  imageUrl               String?
  role                   UserRole            @default(UNASSIGNED)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  consultationPriceRupees Int?
  experience             Int?
  credentialUrl          String?
  description            String?
  verificationStatus     VerificationStatus? @default(PENDING)
  specialty              String?
  bloodGroup             String?
  allergies              String?
  existingConditions     String?
  currentMedications     String?
  city                   String?
  state                  String?
  country                String?
  doctorAppointments     Appointment[]       @relation("DoctorAppointments")
  patientAppointments    Appointment[]       @relation("PatientAppointments")
  availabilities         Availability[]
  notifications          Notification[]
  payouts                Payout[]
  prescriptionsAsDoctor  Prescription[]      @relation("PrescriptionDoctor")
  prescriptionsAsPatient Prescription[]      @relation("PrescriptionPatient")
  reviewsReceived        Review[]            @relation("ReviewDoctor")
  reviewsGiven           Review[]            @relation("ReviewPatient")
  laboratoryMemberships  LaboratoryMembership[]
  doctorLabOrders        LabOrder[]          @relation("LabOrderDoctor")
  patientLabOrders       LabOrder[]          @relation("LabOrderPatient")
  labOrderActions        LabOrderStatusHistory[] @relation("LabOrderHistoryActor")
  laboratoryAuditEvents  LaboratoryAuditEvent[]
  pharmacyMemberships    PharmacyMembership[]
  pharmacyAuditEvents    PharmacyAuditEvent[]
  appointmentRefundDecisions AppointmentRefundDecision[]
  cashCollections         AppointmentCashCollection[]

  @@index([city])
  @@index([state])
  @@index([country])
  @@index([country, state, city])
}

model Availability {
  id          String     @id @default(uuid())
  doctorId    String
  startTime   DateTime
  endTime     DateTime
  status      SlotStatus @default(AVAILABLE)
  dayOfWeek   Int?
  isRecurring Boolean    @default(true)
  blockedDate DateTime?
  doctor      User       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startTime])
  @@index([doctorId, dayOfWeek, status])
}

model Appointment {
  id                    String                @id @default(uuid())
  patientId             String
  doctorId              String
  startTime             DateTime
  endTime               DateTime
  status                AppointmentStatus     @default(SCHEDULED)
  notes                 String?
  patientDescription    String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  videoSessionId        String?
  aiSummary             String?
  aiSpecialtySuggestion String?
  doctor                User                  @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient               User                  @relation("PatientAppointments", fields: [patientId], references: [id])
  reminders             AppointmentReminder[]
  notifications         Notification[]
  prescription          Prescription?
  review                Review?
  labOrders             LabOrder[]
  payment               AppointmentPayment?
  checkoutExpiresAt     DateTime?
  consultationMode      AppointmentMode       @default(ONLINE)
  originalAppointmentId String?               @unique
  originalAppointment   Appointment?          @relation("AppointmentFollowUp", fields: [originalAppointmentId], references: [id], onDelete: Restrict)
  followUpAppointment   Appointment?          @relation("AppointmentFollowUp")

  @@index([status, startTime])
  @@index([doctorId, startTime])
  @@index([doctorId, checkoutExpiresAt])
}

model AppointmentPayment {
  id                    String                   @id @default(uuid())
  appointmentId         String                   @unique
  amountRupees          Int
  amountPaise           Int
  currency              String                   @default("INR")
  status                AppointmentPaymentStatus @default(PENDING)
  method                AppointmentPaymentMethod  @default(ONLINE)
  orderStatus           PaymentOrderStatus       @default(CREATED)
  refundStatus          PaymentRefundStatus      @default(NOT_REQUIRED)
  razorpayOrderId       String?                  @unique
  razorpayPaymentId     String?                  @unique
  verifiedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  appointment           Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  webhookEvents         RazorpayWebhookEvent[]
  refundDecision        AppointmentRefundDecision?
  cashCollection        AppointmentCashCollection?
  payoutAllocations     PayoutPaymentAllocation[]

  @@index([status, createdAt])
  @@index([refundStatus, createdAt])
}

model RazorpayWebhookEvent {
  id                    String                    @id
  eventType             String
  appointmentPaymentId  String?
  razorpayPaymentId     String?
  razorpayOrderId       String?
  amountPaise           Int?
  currency              String?
  status                RazorpayWebhookEventStatus @default(RECEIVED)
  receivedAt            DateTime                  @default(now())
  processedAt           DateTime?
  appointmentPayment    AppointmentPayment?       @relation(fields: [appointmentPaymentId], references: [id], onDelete: Restrict)

  @@index([appointmentPaymentId, status])
  @@index([razorpayPaymentId])
  @@index([razorpayOrderId])
}

model AppointmentRefundDecision {
  id          String               @id @default(uuid())
  paymentId   String               @unique
  adminUserId String
  decision    RefundReviewDecision
  note        String
  createdAt   DateTime             @default(now())
  payment     AppointmentPayment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  admin       User                 @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
}

model AppointmentCashCollection {
  paymentId      String             @id
  collectorUserId String
  collectedAt    DateTime           @default(now())
  payment        AppointmentPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  collector      User               @relation(fields: [collectorUserId], references: [id], onDelete: Restrict)

  @@index([collectorUserId, collectedAt])
}

model Payout {
  id          String       @id @default(uuid())
  doctorId    String
  status      PayoutStatus @default(PROCESSING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  processedAt DateTime?
  processedBy String?
  currency    String?
  amountPaise BigInt?
  platformFeePaise BigInt?
  netAmountPaise BigInt?
  requestKey String? @unique
  transferReference String? @unique
  reviewRequiredAt DateTime?
  reviewReason String?
  doctor      User         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  allocations PayoutPaymentAllocation[]

  @@index([doctorId])
  @@index([status])
  @@index([doctorId, status])
}

model PayoutPaymentAllocation {
  id                  String                  @id @default(uuid())
  payoutId            String
  appointmentPaymentId String
  activePaymentId     String?                 @unique
  amountPaise         BigInt
  status              PayoutAllocationStatus  @default(RESERVED)
  createdAt           DateTime                @default(now())
  releasedAt          DateTime?
  paidAt              DateTime?
  payout              Payout                  @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  appointmentPayment  AppointmentPayment      @relation(fields: [appointmentPaymentId], references: [id], onDelete: Restrict)

  @@index([payoutId, status])
  @@index([appointmentPaymentId, createdAt])
  @@unique([payoutId, appointmentPaymentId])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  appointmentId String?
  type          NotificationType
  title         String
  message       String
  dedupeKey     String           @unique
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([appointmentId, type])
}

model AppointmentReminder {
  id            String       @id @default(uuid())
  appointmentId String
  type          ReminderType
  sentAt        DateTime     @default(now())
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, type])
  @@index([type, sentAt])
}

model Prescription {
  id                  String                 @id @default(uuid())
  appointmentId       String                 @unique
  patientId           String
  doctorId            String
  diagnosis           String?
  generalInstructions String?
  followUpRequired    Boolean                @default(false)
  followUpDays        Int?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  appointment         Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor              User                   @relation("PrescriptionDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  patient             User                   @relation("PrescriptionPatient", fields: [patientId], references: [id], onDelete: Cascade)
  medicines           PrescriptionMedicine[]

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
}

model PrescriptionMedicine {
  id             String       @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  patientId     String
  doctorId      String
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        User        @relation("ReviewDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  patient       User        @relation("ReviewPatient", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId, createdAt])
  @@index([patientId, createdAt])
}

model Laboratory {
  id                 String                 @id @default(uuid())
  name               String
  legalName          String
  registrationNumber String
  /// SQL CHECK constraint in the additive laboratory migration enforces this normalized key.
  registrationNumberNormalized String        @unique
  contactEmail       String
  contactPhone       String
  address            String
  city               String
  state              String
  country            String
  status             LaboratoryStatus       @default(PENDING)
  statusReason       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  memberships        LaboratoryMembership[]
  offerings          LaboratoryOffering[]
  orders             LabOrder[]
  auditEvents        LaboratoryAuditEvent[]

  @@index([status, createdAt])
  @@index([country, state, city])
}

model LaboratoryMembership {
  id             String                     @id @default(uuid())
  laboratoryId   String
  userId         String
  role           LaboratoryRole              @default(STAFF)
  status         LaboratoryMembershipStatus  @default(ACTIVE)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  laboratory     Laboratory                  @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  labOrderActions LabOrderStatusHistory[]    @relation("LabOrderMembershipActor")

  @@unique([laboratoryId, userId])
  @@index([userId, status])
  @@index([laboratoryId, status, role])
}

model LabTest {
  id          String                @id @default(uuid())
  name        String
  /// SQL CHECK constraint in the additive laboratory migration enforces this normalized key.
  normalizedName String             @unique
  code        String?               @unique
  category    String?
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  offerings   LaboratoryOffering[]
  orderItems  LabOrderItem[]

  @@index([isActive, name])
}

model LaboratoryOffering {
  id                       String       @id @default(uuid())
  laboratoryId             String
  labTestId                String
  price                    Decimal      @db.Decimal(10, 2)
  isAvailable              Boolean      @default(true)
  preparationInstructions String?
  estimatedHours           Int?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  laboratory               Laboratory   @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  labTest                  LabTest      @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  orderItems               LabOrderItem[]

  @@unique([laboratoryId, labTestId])
  @@unique([id, laboratoryId, labTestId])
  @@index([labTestId, isAvailable])
  @@index([laboratoryId, isAvailable])
}

model LabOrder {
  id                   String                    @id @default(uuid())
  patientId            String
  doctorId             String?
  appointmentId        String?
  laboratoryId         String?
  source               LabOrderSource
  status               LabOrderStatus             @default(AWAITING_LAB_SELECTION)
  clinicalInstructions String?
  collectionAt         DateTime?
  collectionNotes      String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  patient              User                       @relation("LabOrderPatient", fields: [patientId], references: [id], onDelete: Restrict)
  doctor               User?                      @relation("LabOrderDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  // Keep doctor-order provenance intact: appointment deletion is blocked while
  // an order references it. Cancel appointments by status instead.
  appointment          Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  laboratory           Laboratory?                @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)
  items                LabOrderItem[]
  statusHistory        LabOrderStatusHistory[]

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@index([laboratoryId, status, createdAt])
  @@index([appointmentId])
}

model LabOrderItem {
  id                    String              @id @default(uuid())
  labOrderId            String
  labTestId             String
  /// SQL CHECK constraints and deferred triggers enforce valid all-null/all-assigned tuples and order/appointment provenance.
  laboratoryOfferingId  String?
  laboratoryId          String?
  testName              String
  testCategory          String?
  testDescription       String?
  priceAtBooking        Decimal?            @db.Decimal(10, 2)
  labOrder              LabOrder             @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest               LabTest             @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  laboratoryOffering    LaboratoryOffering? @relation(fields: [laboratoryOfferingId, laboratoryId, labTestId], references: [id, laboratoryId, labTestId], onDelete: Restrict)

  @@unique([labOrderId, labTestId])
  @@index([labTestId])
}

model LabOrderStatusHistory {
  id                      String                    @id @default(uuid())
  labOrderId              String
  actorUserId             String?
  membershipId            String?
  fromStatus              LabOrderStatus?
  toStatus                LabOrderStatus
  note                    String?
  createdAt               DateTime                  @default(now())
  labOrder                LabOrder                  @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  actor                   User?                     @relation("LabOrderHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  membership              LaboratoryMembership?     @relation("LabOrderMembershipActor", fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([labOrderId, createdAt])
  @@index([actorUserId, createdAt])
}

model LaboratoryAuditEvent {
  id             String       @id @default(uuid())
  actorUserId    String?
  laboratoryId   String?
  entityType     String
  entityId       String
  action         String
  fromStatus     String?
  toStatus       String?
  reason         String?
  createdAt      DateTime     @default(now())
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  laboratory     Laboratory? @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)

  @@index([laboratoryId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model Pharmacy {
  id                      String               @id @default(uuid())
  name                    String
  legalName               String
  licenseNumber           String
  licenseNumberNormalized String               @unique
  contactEmail            String
  contactPhone            String
  address                 String
  city                    String
  state                   String
  country                 String
  status                  PharmacyStatus       @default(PENDING)
  statusReason            String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  memberships             PharmacyMembership[]
  products                PharmacyProduct[]
  auditEvents             PharmacyAuditEvent[]

  @@index([status, createdAt])
  @@index([country, state, city])
}

model PharmacyMembership {
  id          String                   @id @default(uuid())
  pharmacyId  String
  userId      String
  role        PharmacyRole             @default(STAFF)
  status      PharmacyMembershipStatus @default(ACTIVE)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  pharmacy    Pharmacy                 @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, userId])
  @@index([userId, status])
  @@index([pharmacyId, status, role])
}

model PharmacyProduct {
  id          String   @id @default(uuid())
  pharmacyId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, isAvailable, name])
}

model PharmacyAuditEvent {
  id          String    @id @default(uuid())
  actorUserId String?
  pharmacyId  String?
  entityId    String
  action      String
  fromStatus  String?
  toStatus    String?
  reason      String?
  createdAt   DateTime  @default(now())
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  @@index([pharmacyId, createdAt])
  @@index([actorUserId, createdAt])
}

enum UserRole {
  UNASSIGNED
  PATIENT
  DOCTOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum AppointmentStatus {
  PAYMENT_PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
  CONFIRMED
  IN_PROGRESS
  NO_SHOW
}

enum AppointmentPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CASH_DUE
  CANCELLED
}

enum AppointmentMode {
  ONLINE
  OFFLINE
}

enum AppointmentPaymentMethod {
  ONLINE
  CASH
  UPI_QR
}

enum PaymentOrderStatus {
  CREATED
  PAID
  EXPIRED
  NOT_APPLICABLE
}

enum PaymentRefundStatus {
  NOT_REQUIRED
  REVIEW_REQUIRED
  APPROVED
  REFUNDED
  REJECTED
}

enum RazorpayWebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  REVIEW_REQUIRED
}

enum RefundReviewDecision {
  APPROVED
  REJECTED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
  NO_SHOW
  DOCTOR_VERIFICATION
  PAYOUT_STATUS
  PRESCRIPTION_AVAILABLE
  LAB_ORDER_UPDATE
}

enum ReminderType {
  TWENTY_FOUR_HOURS
  THIRTY_MINUTES
}

enum PayoutStatus {
  PROCESSING
  COMPLETED
  FAILED
  PROCESSED
}

enum PayoutAllocationStatus {
  RESERVED
  RELEASED
  PAID
}

enum LaboratoryStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PharmacyStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PharmacyRole {
  OWNER
  MANAGER
  STAFF
}

enum PharmacyMembershipStatus {
  ACTIVE
  REVOKED
}

enum LaboratoryRole {
  OWNER
  MANAGER
  STAFF
}

enum LaboratoryMembershipStatus {
  ACTIVE
  REVOKED
}

enum LabOrderSource {
  DOCTOR
  PATIENT
}

enum LabOrderStatus {
  AWAITING_LAB_SELECTION
  REQUESTED
  ACCEPTED
  REJECTED
  COLLECTION_SCHEDULED
  COLLECTED
  CANCELLED
}
