generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(uuid())
  clerkUserId            String              @unique
  email                  String              @unique
  name                   String?
  imageUrl               String?
  role                   UserRole            @default(UNASSIGNED)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  credits                Int                 @default(2)
  experience             Int?
  credentialUrl          String?
  description            String?
  verificationStatus     VerificationStatus? @default(PENDING)
  specialty              String?
  bloodGroup             String?
  allergies              String?
  existingConditions     String?
  currentMedications     String?
  city                   String?
  state                  String?
  country                String?
  doctorAppointments     Appointment[]       @relation("DoctorAppointments")
  patientAppointments    Appointment[]       @relation("PatientAppointments")
  availabilities         Availability[]
  transactions           CreditTransaction[]
  notifications          Notification[]
  payouts                Payout[]
  prescriptionsAsDoctor  Prescription[]      @relation("PrescriptionDoctor")
  prescriptionsAsPatient Prescription[]      @relation("PrescriptionPatient")
  reviewsReceived        Review[]            @relation("ReviewDoctor")
  reviewsGiven           Review[]            @relation("ReviewPatient")

  @@index([city])
  @@index([state])
  @@index([country])
  @@index([country, state, city])
}

model Availability {
  id          String     @id @default(uuid())
  doctorId    String
  startTime   DateTime
  endTime     DateTime
  status      SlotStatus @default(AVAILABLE)
  dayOfWeek   Int?
  isRecurring Boolean    @default(true)
  blockedDate DateTime?
  doctor      User       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startTime])
  @@index([doctorId, dayOfWeek, status])
}

model Appointment {
  id                    String                @id @default(uuid())
  patientId             String
  doctorId              String
  startTime             DateTime
  endTime               DateTime
  status                AppointmentStatus     @default(SCHEDULED)
  notes                 String?
  patientDescription    String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  videoSessionId        String?
  aiSummary             String?
  aiSpecialtySuggestion String?
  doctor                User                  @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient               User                  @relation("PatientAppointments", fields: [patientId], references: [id])
  reminders             AppointmentReminder[]
  notifications         Notification[]
  prescription          Prescription?
  review                Review?

  @@index([status, startTime])
  @@index([doctorId, startTime])
}

model CreditTransaction {
  id            String          @id @default(uuid())
  userId        String
  amount        Int
  type          TransactionType
  packageId     String?
  createdAt     DateTime        @default(now())
  allocationKey String?         @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payout {
  id          String       @id @default(uuid())
  doctorId    String
  amount      Int
  status      PayoutStatus @default(PROCESSING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  credits     Int          @default(0)
  platformFee Int          @default(0)
  netAmount   Int          @default(0)
  paypalEmail String?
  processedAt DateTime?
  processedBy String?
  doctor      User         @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([status])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  appointmentId String?
  type          NotificationType
  title         String
  message       String
  dedupeKey     String           @unique
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([appointmentId, type])
}

model AppointmentReminder {
  id            String       @id @default(uuid())
  appointmentId String
  type          ReminderType
  sentAt        DateTime     @default(now())
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, type])
  @@index([type, sentAt])
}

model Prescription {
  id                  String                 @id @default(uuid())
  appointmentId       String                 @unique
  patientId           String
  doctorId            String
  diagnosis           String?
  generalInstructions String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  appointment         Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor              User                   @relation("PrescriptionDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  patient             User                   @relation("PrescriptionPatient", fields: [patientId], references: [id], onDelete: Cascade)
  medicines           PrescriptionMedicine[]

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
}

model PrescriptionMedicine {
  id             String       @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  patientId     String
  doctorId      String
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        User        @relation("ReviewDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  patient       User        @relation("ReviewPatient", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId, createdAt])
  @@index([patientId, createdAt])
}

enum UserRole {
  UNASSIGNED
  PATIENT
  DOCTOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  CONFIRMED
  IN_PROGRESS
  NO_SHOW
}

enum TransactionType {
  CREDIT_PURCHASE
  APPOINTMENT_DEDUCTION
  ADMIN_ADJUSTMENT
  APPOINTMENT_REFUND
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
  NO_SHOW
  DOCTOR_VERIFICATION
  PAYOUT_STATUS
  CREDIT_TRANSACTION
  PRESCRIPTION_AVAILABLE
}

enum ReminderType {
  TWENTY_FOUR_HOURS
  THIRTY_MINUTES
}

enum PayoutStatus {
  PROCESSING
  COMPLETED
  FAILED
  PROCESSED
}
